<?xml version="1.0" ?>
<!--
    Dependency Injection container configuration for {{pluginName}}.
    @see https://developer.shopware.com/docs/guides/plugins/plugins/plugin-fundamentals/dependency-injection
    @version Shopware {{minShopwareVersion}}
-->
<container xmlns="http://symfony.com/schema/dic/services"
           xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
           xsi:schemaLocation="http://symfony.com/schema/dic/services http://symfony.com/schema/dic/services/services-1.0.xsd">
    <services>
{{services}}
    </services>
</container>
