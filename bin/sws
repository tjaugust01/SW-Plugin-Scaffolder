#!/usr/bin/env php
<?php
require __DIR__ . '/../vendor/autoload.php';

use ShopwareScaffolding\Command\CreatePluginCommand;
use Symfony\Component\Console\Application;

$app = new Application('Shopware Plugin Scaffold', '1.0.0');
$app->addCommand(new CreatePluginCommand());
$app->setDefaultCommand('create:plugin', true); // direkt starten ohne Command-Name
$app->run();