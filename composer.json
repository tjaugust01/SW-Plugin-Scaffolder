{
    "name": "tjaugust01/shopware-scaffolding",
    "description": "Shopware 6 Plugin Scaffolding CLI",
    "autoload": {
        "psr-4": {
            "ShopwareScaffolding\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "ShopwareScaffolding\\Tests\\": "tests/"
        }
    },
    "authors": [
        {
            "name": "tjaugust01",
            "email": "tomaugust2001@proton.me"
        }
    ],
    "minimum-stability": "stable",
    "bin": ["bin/sws"],
    "require": {
        "symfony/console": "^7.0",
        "symfony/filesystem": "^7.0",
        "symfony/finder": "^7.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^12.5",
        "symfony/phpunit-bridge": "^8.1"
    }
}
